# ===========================================================================
# Mazyoud Collection Vote — environment configuration
# Copy to `.env` and fill in. Every key is documented in the README.
# ===========================================================================

# --- Google Sheet ----------------------------------------------------------
# The spreadsheet id from the sheet URL: /spreadsheets/d/<THIS>/edit
SPREADSHEET_ID=
# Source product tab name (the buying template). Note the space.
SHEET_PRODUCTS_TAB=AID 1

# Service account credentials. Provide ONE of these:
#  - GOOGLE_SERVICE_ACCOUNT_JSON: base64 of the service-account key JSON
#      (macOS/Linux: base64 -w0 key.json   |   macOS: base64 -i key.json)
#  - GOOGLE_APPLICATION_CREDENTIALS: absolute path to the key JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/sa.json

# --- Backend selection -----------------------------------------------------
# google = direct Sheets API (default, full-featured) | n8n = webhook drop-in
DATA_BACKEND=google

# --- Sessions / auth -------------------------------------------------------
# Long random string. Generate: openssl rand -hex 32
SESSION_SECRET=
# Session lifetime in seconds (default 12h).
SESSION_TTL=43200
# Store/compare PINs as salted-sha256 ("salt$hash") instead of plain text.
HASH_PINS=false

# --- HTTP ------------------------------------------------------------------
PORT=8080
APP_ORIGIN=https://vote.mazyoud.com

# --- Images ----------------------------------------------------------------
# Comma-separated allowlist for the image proxy. Entries beginning with a dot
# match subdomains (".alicdn.com" matches "cbu01.alicdn.com"). Add your
# Backblaze B2 host here too.
IMG_ALLOWED_HOSTS=cbu01.alicdn.com,.alicdn.com,.1688.com

# --- Feature flags ---------------------------------------------------------
# Mirror net/verdict/conflict/breakdown into AID 1 columns W..Z (anchor rows).
INLINE_WRITEBACK=true
# Show extra metadata (title/category) on the card. The card shows only image
# + price when false (default, and the hard product requirement).
SHOW_DETAILS=false
# Allow a voter to swipe products they've already voted on (latest wins).
ALLOW_REVOTE=false

# --- Caching ---------------------------------------------------------------
# Product cache TTL in ms (default 5 min). Products rarely change mid-session.
PRODUCTS_CACHE_TTL=300000

# --- Admin -----------------------------------------------------------------
# Optional shared secret for POST /api/refresh (x-admin-token header).
# If empty, any logged-in voter may trigger a product cache refresh.
ADMIN_TOKEN=

# --- n8n backend (only when DATA_BACKEND=n8n) ------------------------------
N8N_PRODUCTS_URL=
N8N_APPEND_VOTE_URL=
N8N_VOTES_URL=
