# ─────────────────────────────────────────────────────────────────────────────
# Mazyoud Listing Forge — environment example
#
# The PRIMARY way to provide an API key is the in-app Settings panel (stored in
# the OS keychain or a gitignored local app-data file). These .env values are a
# FALLBACK only. Copy this file to `.env` and fill in what you need.
# NEVER commit your real .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5174

# AI provider fallback keys (phase 2+). Leave blank to rely on the keychain.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override the active provider / model without touching config.ts
# AI_PROVIDER=gemini
# GEMINI_MODEL_ID=gemini-3-pro-image-preview
# OPENAI_MODEL_ID=gpt-image-1

# Default output folder for "Write to folder" (phase 1). Defaults to ./output
# OUTPUT_DIR=./output

# ── Phase 5 stubs (disabled by default) ──────────────────────────────────────
# Backblaze B2
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=

# WooCommerce / WordPress media (Application Password)
# WP_BASE_URL=
# WP_USERNAME=
# WP_APP_PASSWORD=
